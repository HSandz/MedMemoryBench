# OpenAI-compatible API
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_BASE=https://api.openai.com/v1

# OpenRouter (OpenAI-compatible API)
# OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modal-hosted vLLM; the deployment script reads `.env`, with shell overrides.
# Account token for deployment; Proxy Token for inference.
# MODAL_TOKEN_ID=ak-<id>
# MODAL_TOKEN_SECRET=as-<secret>
# HF_TOKEN=hf_<token>
# MODAL_API_KEY=wk-<id>.ws-<secret>
# MODAL_BASE_URL=https://<workspace>--<app>-server.<region>.modal.direct/v1
# Deployment overrides
# MODAL_APP_NAME=medmemorybench-vllm
# MODAL_GPU=L40S
# MODAL_VLLM_MODEL=ELVISIO/Qwen3-30B-A3B-Instruct-2507-AWQ
# MODAL_VLLM_SERVED_MODEL=ELVISIO/Qwen3-30B-A3B-Instruct-2507-AWQ
# MODAL_VLLM_MAX_MODEL_LEN=32768
# MODAL_VLLM_SCALEDOWN_WINDOW_SECONDS=300
# MODAL_VLLM_WARMUP=true
# MODAL_VLLM_WARMUP_PROMPT_LENGTHS=128,512,2048,8192
# MODAL_VLLM_WARMUP_MAX_TOKENS=32
# MODAL_VLLM_GPU_MEMORY_UTILIZATION=0.9
# Client readiness polling
# MODAL_READY_TIMEOUT_SECONDS=1200
# MODAL_READY_POLL_SECONDS=5
DEFAULT_LLM_MODEL=gpt-4o

# ChatGLM BigModel API
# BIGMODEL_API_KEY=your_bigmodel_api_key_here
# BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Azure OpenAI
# AZURE_OPENAI_API_KEY=your_azure_api_key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-02-01
# AZURE_OPENAI_DEPLOYMENT=your_deployment_name

# Vertex AI; service-account paths may be comma-separated for rotation.
# GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json,service-account-2.json,service-account-3.json
# GOOGLE_CLOUD_LOCATION=global
# Use a private, run-specific prefix for retained batch data.
# GOOGLE_BATCH_GCS_URI=gs://your-private-bucket/medmemorybench-batch

# Google AI Studio; store one key per line in this ignored, project-relative file.
# GOOGLE_AI_STUDIO_API_KEYS_FILE=secrets/google_ai_studio_api_keys.txt
# Key rotation strategy: sequential (failure-driven, default) or round_robin.
# GOOGLE_AI_STUDIO_KEY_ROTATION_MODE=sequential
# Successful calls served by each key before round_robin advances (default: 1).
# GOOGLE_AI_STUDIO_ROUND_ROBIN_CALLS_PER_KEY=1
# Full passes through the key pool per LLM call; use -1 to retry indefinitely.
# GOOGLE_AI_STUDIO_MAX_ROTATION_ROUNDS=1
# Retries on the same key for generic "Resource has been exhausted" 429s.
# GOOGLE_AI_STUDIO_RESOURCE_EXHAUSTED_RETRIES=3
# Permanently invalid project or credential keys are removed from this key file.
# Inline keys remain supported for backwards compatibility.
# GOOGLE_AI_STUDIO_API_KEYS=key_one,key_two,key_three

# Judge model
# JUDGE_PROVIDER=openai
# JUDGE_MODEL=gpt-4o
# JUDGE_API_KEY=your_judge_api_key
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_TEMPERATURE=0.0
# JUDGE_REASONING_EFFORT=low
# JUDGE_CLIENT_MAX_TOKENS=10000
# JUDGE_MAX_TOKENS=500
# JUDGE_MCD_MAX_TOKENS=2000
# Providers: openai, openrouter, modal, azure, anthropic, vertex, gemini, ai_studio
# JUDGE_API_KEYS=judge_key_one,judge_key_two

# Shared retries for every LLM provider and provider credential/key rotation.
LLM_MAX_RETRIES=5
# Exponential delay: 1, 2, 4, ... seconds, always capped at 100 seconds.
LLM_RETRY_MIN_DELAY=1.0
LLM_RETRY_MAX_DELAY=100.0
# Client-side timeout for OpenAI-compatible LLM requests, in seconds.
LLM_REQUEST_TIMEOUT_SECONDS=180.0
# Maximum output-token budget used by automatic truncation retries.
LLM_TRUNCATION_MAX_TOKENS=32768

# Embeddings: OpenAI
# DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_PROVIDER=openai

# Embeddings: local Hugging Face
# DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_PROVIDER=local

# Zep
# ZEP_API_KEY=your_zep_api_key

# General
LOG_LEVEL=INFO

# MIRIX PostgreSQL; start with `./scripts/mirix-services.sh start`.
MIRIX_PG_USER=mirix
MIRIX_PG_PASSWORD=mirix
MIRIX_PG_DB=mirix
MIRIX_PG_HOST=localhost
MIRIX_PG_PORT=5432
# Overrides individual PostgreSQL settings
# MIRIX_PG_URI=postgresql+pg8000://mirix:mirix@localhost:5432/mirix

# MIRIX Redis; use `./scripts/mirix-services.sh start-all` when enabled.
MIRIX_REDIS_ENABLED=false
MIRIX_REDIS_HOST=localhost
MIRIX_REDIS_PORT=6379

MIRIX_LOG_LEVEL=INFO
