# ============================================================================
# LLM API Configuration
# ============================================================================
# OpenAI-compatible API (default)
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_BASE=https://api.openai.com/v1

# Modal-hosted vLLM (provider: modal). Use the deployed Server URL with /v1.
# Modal deployment account token (ak-/as-), supplied to Modal commands through
# the shell environment. These are separate from the inference Proxy Token.
# MODAL_TOKEN_ID=ak-<id>
# MODAL_TOKEN_SECRET=as-<secret>
# Modal Server Proxy Token (wk-/ws-), used by benchmark API requests.
# MODAL_API_KEY=wk-<id>.ws-<secret>
# MODAL_BASE_URL=https://<workspace>--<app>-server.<region>.modal.direct/v1
DEFAULT_LLM_MODEL=gpt-4o

# ChatGLM BigModel API (optional, for GLM series models)
# BIGMODEL_API_KEY=your_bigmodel_api_key_here
# BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Azure OpenAI API (optional)
# AZURE_OPENAI_API_KEY=your_azure_api_key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-02-01
# AZURE_OPENAI_DEPLOYMENT=your_deployment_name

# Vertex AI / Google Agent Platform (provider: vertex)
# Uses service-account.json in the repository root by default. Relative paths
# resolve from the repository root; list files in rotation order.
# GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json,service-account-2.json,service-account-3.json
# GOOGLE_VERTEX_SERVICE_ACCOUNT_RETRIES=5
# GOOGLE_CLOUD_LOCATION=global
# Private Cloud Storage prefix for optional Vertex batch jobs. Prompts and outputs
# are retained here for resume, so do not use a public bucket or a shared prefix.
# GOOGLE_BATCH_GCS_URI=gs://your-private-bucket/medmemorybench-batch

# Google AI Studio / Gemini Developer API (provider: ai_studio)
# One key may use GEMINI_API_KEY or GOOGLE_API_KEY. For rotation, list keys in
# priority order; the client retries one key five times before moving to the next.
# GOOGLE_AI_STUDIO_API_KEYS=key_one,key_two,key_three
# GOOGLE_AI_STUDIO_KEY_RETRIES=5
# provider: gemini starts with Vertex, then rotates through these AI Studio keys.
# Batch requests for provider: gemini always use Vertex.

# ============================================================================
# Judge Model Settings (for evaluation metrics)
# ============================================================================
# The judge model is used by the evaluation pipeline to score agent responses.
# It can be different from the main LLM model.
# JUDGE_PROVIDER=openai
# JUDGE_MODEL=gpt-4o
# JUDGE_API_KEY=your_judge_api_key
# JUDGE_BASE_URL=https://api.openai.com/v1
# Generation settings used by real-time, batch, and --rejudge judge calls.
# JUDGE_TEMPERATURE=0.0
# JUDGE_CLIENT_MAX_TOKENS=10000
# JUDGE_MAX_TOKENS=500
# JUDGE_MCD_MAX_TOKENS=2000
# Vertex Gemini judge: uses the same rotating service-account list as the main provider.
# JUDGE_PROVIDER=vertex
# JUDGE_MODEL=gemini-2.5-flash
# Hybrid judge: starts with Vertex and rotates through the configured AI Studio keys.
# JUDGE_PROVIDER=gemini
# JUDGE_MODEL=gemini-2.5-flash
# AI Studio judge: uses GOOGLE_AI_STUDIO_API_KEYS unless judge-specific keys are set.
# JUDGE_PROVIDER=ai_studio
# JUDGE_MODEL=gemini-2.5-flash
# JUDGE_API_KEYS=judge_key_one,judge_key_two

# Shared retry settings for provider calls. Gemini uses exponential backoff.
# LLM_MAX_RETRIES=10
# LLM_RETRY_MIN_DELAY=10.0
# LLM_RETRY_MAX_DELAY=20.0
# GEMINI_MAX_RETRIES=100
# GEMINI_RETRY_INITIAL_DELAY=1.0
# GEMINI_RETRY_MAX_DELAY=100.0

# ============================================================================
# Embedding Settings
# ============================================================================
# Option 1: OpenAI Embedding API
# DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_PROVIDER=openai

# Option 2: Local embedding model from Hugging Face (downloaded and cached on first use)
# Used when a method YAML's configured local embedding directory is unavailable.
# DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_PROVIDER=local

# ============================================================================
# Zep Cloud Configuration (required for Zep method evaluation)
# ============================================================================
# ZEP_API_KEY=your_zep_api_key

# ============================================================================
# General Settings
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# MIRIX Configuration (required for MIRIX method evaluation)
# ============================================================================
# PostgreSQL Database (required for MIRIX)
# Start the database service first:
#   ./scripts/mirix-services.sh start
MIRIX_PG_USER=mirix
MIRIX_PG_PASSWORD=mirix
MIRIX_PG_DB=mirix
MIRIX_PG_HOST=localhost
MIRIX_PG_PORT=5432
# Full URI (overrides individual settings if set)
# MIRIX_PG_URI=postgresql+pg8000://mirix:mirix@localhost:5432/mirix

# Redis Configuration (optional, improves MIRIX performance)
# To enable Redis, set MIRIX_REDIS_ENABLED=true and run:
#   ./scripts/mirix-services.sh start-all
MIRIX_REDIS_ENABLED=false
MIRIX_REDIS_HOST=localhost
MIRIX_REDIS_PORT=6379

MIRIX_LOG_LEVEL=INFO
